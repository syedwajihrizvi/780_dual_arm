<!-- Fixed overhead RGB-D camera -->
<model name="overhead_rgbd">
<static>true</static>
<!-- World pose: above the midpoint between the arm bases (x 0.2 and 1.5),
     looking down. Yaw pi/2 lines the image width up with the table's long
     axis: image right = world +x (Panda 2), image down = world -y. 2.6 m keeps
     both arms fully in view. -->
<pose>0.85 0 2.6 0 1.57079632679 1.57079632679</pose>
<link name="camera_link">
<!-- Visible RGB-D camera housing -->
<visual name="camera_body">
  <geometry>
    <box>
      <size>0.12 0.08 0.05</size>
    </box>
  </geometry>

  <material>
    <ambient>0.08 0.08 0.10 1</ambient>
    <diffuse>0.12 0.12 0.15 1</diffuse>
    <specular>0.4 0.4 0.4 1</specular>
  </material>
</visual>

<!-- Camera lens -->
<visual name="camera_lens">
  <pose>0.03 0 0 0 1.57079632679 0</pose>

  <geometry>
    <cylinder>
      <radius>0.018</radius>
      <length>0.015</length>
    </cylinder>
  </geometry>

  <material>
    <ambient>0.02 0.04 0.08 1</ambient>
    <diffuse>0.03 0.06 0.12 1</diffuse>
  </material>
</visual>
<sensor name="rgbd_sensor" type="rgbd_camera">
<always_on>true</always_on>
<update_rate>10</update_rate>
<visualize>false</visualize>
<topic>/overhead_camera</topic>
<camera>
<horizontal_fov>1.5708</horizontal_fov>
<image>
<width>960</width>
<height>720</height>
</image>
<clip>
<near>0.1</near>
<far>4.0</far>
</clip>
</camera>
</sensor>
</link>
</model>
</world>
</sdf>
